{
  "name": "hta-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "HTA Calibration Desktop — Offline calibration certificate drafting",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "tsc && node -e \"const fs=require('fs'),p=require('path');const s='src/migrations',d='dist/migrations';fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).filter(f=>f.endsWith('.sql')).forEach(f=>fs.copyFileSync(p.join(s,f),p.join(d,f)))\" && concurrently -n electron,tsc \"electron .\" \"tsc -w --preserveWatchOutput\"",
    "build": "tsc && node -e \"const fs=require('fs'),p=require('path');const s='src/migrations',d='dist/migrations';fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).filter(f=>f.endsWith('.sql')).forEach(f=>fs.copyFileSync(p.join(s,f),p.join(d,f)))\"",
    "start": "electron .",
    "prepackage": "node scripts/download-wireguard.js && node scripts/copy-standalone.js",
    "package": "electron-builder --config electron-builder.yml --win",
    "package:dir": "electron-builder --config electron-builder.yml --win --dir",
    "package:msi": "electron-builder --config electron-builder.yml --win nsis msiWrapped",
    "build:full": "node scripts/build-full.js",
    "build:msi": "node scripts/build-full.js --msi",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@journeyapps/sqlcipher": "^5.3.1",
    "electron-updater": "^6.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "3.2.4",
    "concurrently": "^9.0.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
