# Dependencies (will be installed in container)
node_modules
**/node_modules

# Build outputs (will be rebuilt in container)
dist
**/dist
.next
**/.next

# Development files
.git
.gitignore
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# IDE and editor files
.idea
.vscode
*.swp
*.swo

# Test files
tests
**/tests
**/*.test.ts
**/*.spec.ts
coverage
**/coverage

# Documentation
docs
*.md
!README.md

# OS files
.DS_Store
Thumbs.db

# Desktop app build artifacts
apps/desktop/.next-standalone
apps/desktop/release
apps/desktop/resources/wireguard-amd64.msi

# Large things no image needs.
#
# The build context is everything not excluded here, and it is sent in full before a
# build starts - so anything left in costs time on every build, local or remote. These
# four came to about half a gigabyte: sample certificates kept for reference, uploads
# written at runtime, the graph tool's output, and infrastructure code that describes
# the cluster rather than running in it.
apps/web-hta/reference_docs
apps/web-hta/storage
**/storage
graphify-out
terraform

# Turborepo
.turbo
**/.turbo

# Claude Code worktrees (contain old/experimental code)
.claude
.claude/
.claude/**
**/.claude
**/.claude/**

# Misc
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
