// ============================================================================
// CALIBRATION PARAMETERS
// ============================================================================
//
// What a lab can calibrate, in two layers.
//
// The standards are one shared list, seeded from the master instrument registry and
// never edited by a tenant: they are what the masters are recorded against, so renaming
// one here would break the match between a certificate and the instrument that served
// it. Each tenant gets its own row per standard, holding the name its engineers use.

model CalibrationParameterStandard {
  id           String   @id @default(uuid())
  /// The registry's own name, which is what master capabilities are recorded against.
  standardName String   @unique
  /// How the dropdown groups it. Too coarse to match on - Electrical holds voltage,
  /// current and resistance together - which is what `measures` and `kind` are for.
  category     String
  /// What is actually measured. Different measurands never serve each other, however
  /// alike the units look: flatness is in microns and length in millimetres.
  measures     String   @default("")
  /// Which kind of it, where there is more than one: dc against ac, rtd against
  /// thermocouple, gauge against absolute. "any" where the parameter does not say.
  kind         String   @default("any")
  units        String[]
  defaultUnit  String?
  /// Curves and types the capability distinguishes - Pt-100, Type K, and so on.
  subtypes     String[]
  /// Other names for the same quantity, including the ones already on certificates:
  /// "Voltage DC" for "DC Voltage", "Humidity" for "Relative Humidity".
  aliases      String[]
  /// "registry" where a master records it, "certificates" where only a certificate does.
  source       String
  seedVersion  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parameters CalibrationParameter[]

  @@index([category])
}

model CalibrationParameter {
  id          String   @id @default(uuid())
  tenantId    String
  standardId  String
  /// What this lab calls it. Defaults to the standard name.
  customName  String
  /// Set only where the lab wants something other than the standard's.
  units       String[]
  defaultUnit String?
  subtypes    String[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  standard CalibrationParameterStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@unique([tenantId, standardId])
  @@index([tenantId, active])
}

// ---------------------------------------------------------------------------
// Master instrument capabilities
//
// Additive. Nothing above is altered; the flat columns on MasterInstrument stay
// exactly as they are and keep being written until their readers are moved.
// Design and rationale: docs/scope/master-capability-schema.md
//
// These hang off instrumentId - the stable identity - and not MasterInstrument.id,
// which is one version of an instrument. MasterInstrumentCertificate attaches to the
// version row, and 25 of 210 certificates are stranded on superseded versions as a
// result. MasterInstrumentTraining already uses instrumentId; this follows it.
// ---------------------------------------------------------------------------

enum CapabilityKind {
  RANGE // 365 profiles — a measuring or sourcing span
  ARTIFACT //   4 profiles — a fixed value, e.g. a 2 kg mass
}

enum CapabilityRole {
  MEASURING // 301
  SOURCE //  68
}

enum AccuracyKind {
  SYMMETRIC // 1411 buckets — ±0.6 °C
  ASYMMETRIC //    0 buckets so far — +0.5 / −0.3 °C, which is not a ± anything
  FORMULA //  120 buckets — ±(0.02% of reading + 2 counts)
  CLASS //    2 buckets — Class 1
}

model MasterCapabilityProfile {
  id           String @id @default(uuid())
  tenantId     String
  instrumentId String // stable identity, NOT MasterInstrument.id

  profileKey String // "P1" — the registry's own id, kept for traceability
  parameter  String // "Thermocouple", "Pressure", "Mass"
  role       CapabilityRole
  unit       String // "°C", "bar", "kg"
  kind       CapabilityKind @default(RANGE)

  // Overall span. Null for ARTIFACT, which carries its value on its single bucket.
  minValue     Decimal? @db.Decimal(20, 9)
  maxValue     Decimal? @db.Decimal(20, 9)
  minInclusive Boolean  @default(true)
  maxInclusive Boolean  @default(true)

  // Set when the parameter splits: "thermocouple_type", "rtd_type". Null means the
  // buckets hang directly off this profile.
  subtypeKind String?
  /// "indicator" | "sensor" - which half of a two-part instrument this describes.
  /// Not "component": that name is already the relation to the component row, which
  /// is about identity. 580 HTAIPL/L has the part without the identity.
  part        String?
  /// How it measures where one instrument measures two ways, e.g. "height", "outside".
  mode        String?

  // Decision 2 of master-instrument-model-decisions.md: a procedure belongs to a
  // parameter, not to a box.
  sopReferences String[] @default([])

  // Which part of the instrument has this capability. Null means the instrument as a
  // whole. 188 HTAIPL/L is one indicator with three transducers, and its 0-700 bar
  // profile belongs to the high pressure one - without this there is no honest answer
  // to which capability a certificate covers.
  componentId String?

  // How the seed knows what an admin has touched and must not overwrite.
  source    String @default("registry") // "registry" | "manual"
  sortOrder Int    @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  tenant       Tenant                        @relation(fields: [tenantId], references: [id])
  component    MasterInstrumentComponent?    @relation(fields: [componentId], references: [id], onDelete: SetNull)
  subtypes     MasterCapabilitySubtype[]
  buckets      MasterCapabilityBucket[]
  certificates MasterInstrumentCertificate[]

  @@unique([tenantId, instrumentId, profileKey])
  @@index([tenantId, instrumentId])
  @@index([parameter])
  @@index([componentId])
}

model MasterCapabilitySubtype {
  id        String @id @default(uuid())
  profileId String

  subtypeKey String // "Type J", "Pt-100"

  // Its own span: Type J stops at 1200 °C where Type K goes further.
  minValue     Decimal? @db.Decimal(20, 9)
  maxValue     Decimal? @db.Decimal(20, 9)
  minInclusive Boolean  @default(true)
  maxInclusive Boolean  @default(true)

  sortOrder Int @default(0)

  profile MasterCapabilityProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  buckets MasterCapabilityBucket[]

  @@unique([profileId, subtypeKey])
  @@index([profileId])
}

model MasterCapabilityBucket {
  id        String  @id @default(uuid())
  profileId String
  subtypeId String? // null when the profile has no subtypes

  bucketKey String // "B1"

  minValue     Decimal? @db.Decimal(20, 9)
  maxValue     Decimal? @db.Decimal(20, 9)
  minInclusive Boolean  @default(true)
  maxInclusive Boolean  @default(true)

  // Declared on 1443 buckets, absent on 121. Null means "not declared", which is not
  // the same as zero and must stay distinguishable.
  leastCountValue Decimal? @db.Decimal(20, 9)
  leastCountUnit  String?

  // Null on 31 buckets. The three shapes are the three the data actually holds.
  accuracyKind     AccuracyKind?
  accuracyValue    Decimal?      @db.Decimal(20, 9) // SYMMETRIC
  accuracyUnit     String? // SYMMETRIC — "°C", "%FS"
  accuracyPolarity String? // SYMMETRIC — "±"
  accuracyFormula  String? // FORMULA — kept verbatim
  accuracyClass    String? // CLASS — "Class 1"

  // FORMULA, taken apart. The text is what the certificate says; these are what the
  // app computes with. "+/-0.02% of reading +/-2 count" at a 12 V reading is
  // 0.0002 x 12 plus 2 x the least count, and none of that can be got from the
  // sentence - percentOf alone is the difference between 0.02% of the reading and
  // 0.02% of full scale, which on a 0-30 V range is two and a half times.
  //
  // digitsUnit earns its own column because the register writes the same idea eight
  // ways - d, digit, digits, dgt, count, Count - and twice it is not a display digit
  // at all but ohms.
  accuracyPercentOf    String? // "reading" | "full_scale" | "fsd" | "rh" | "hd"
  accuracyPercentValue Decimal? @db.Decimal(20, 9) // 0.0002 for 0.02%
  // Decimal, not Int: the data holds 0.01 and 0.1 as well as 1 and 2.
  accuracyDigits       Decimal? @db.Decimal(20, 9)
  accuracyDigitsUnit   String?
  /// The accuracy as arithmetic over {reading} {full scale} {span} {least count},
  /// for the shapes the four columns above cannot hold. Null where they can.
  accuracyExpression   String?

  // ASYMMETRIC. A bound that is +0.5 on one side and −0.3 on the other is not a
  // ± anything, and rounding it to the larger of the two would overstate the
  // instrument. accuracyValue and accuracyPolarity stay null for this kind.
  accuracyUpper Decimal? @db.Decimal(20, 9)
  accuracyLower Decimal? @db.Decimal(20, 9)

  sortOrder Int @default(0)

  profile MasterCapabilityProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subtype MasterCapabilitySubtype? @relation(fields: [subtypeId], references: [id], onDelete: Cascade)

  // Uniqueness is enforced by a NULLS NOT DISTINCT index created in the migration;
  // a plain @@unique does not hold when subtypeId is null. See below.
  @@index([profileId])
  @@index([subtypeId])
}

model MasterInstrumentComponent {
  id           String @id @default(uuid())
  tenantId     String
  instrumentId String // stable identity, as with capability profiles

  // Whatever the lab calls this part: Indicator, Sensor, High Pressure Transducer,
  // Readout, Bath. Not an enum — the registry only ever recorded an indicator and a
  // sensor, and baking those two in would make every other kind of part unrecordable.
  name         String
  componentKey String // stable across edits, never reused

  make         String? // null means "same as the instrument's own make"
  model        String?
  serialNumber String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant                    @relation(fields: [tenantId], references: [id])
  capabilities MasterCapabilityProfile[]

  @@unique([tenantId, instrumentId, componentKey])
  @@index([tenantId, instrumentId])
}

model MasterCapabilityAudit {
  id           String @id @default(uuid())
  tenantId     String
  instrumentId String

  action      String // PROFILE_ADDED, BUCKET_UPDATED, PROFILE_DELETED, ...
  profileKey  String? // "P1"
  subtypeKey  String? // "Type J"
  bucketKey   String? // internal, stable, never reused
  // The range as it read when the change was made - "0 to 100 bar". Ranges are shown by
  // position now, and positions shift when one is deleted, so a past entry saying
  // "range 2" would quietly come to mean a different range. This does not.
  bucketLabel String?
  field       String? // "leastCountValue"
  beforeValue String?
  afterValue  String?

  actorId   String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([tenantId, instrumentId, createdAt])
}
