generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// TENANT MODEL - Multi-tenancy support
// ============================================================================

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  domain    String?
  settings  Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations to tenant-scoped models
  users                User[]
  customerUsers        CustomerUser[]
  customerAccounts     CustomerAccount[]
  certificates         Certificate[]
  emailDeliveries      EmailDelivery[]
  masterInstruments    MasterInstrument[]
  capabilityProfiles   MasterCapabilityProfile[]
  capabilityAudits     MasterCapabilityAudit[]
  instrumentComponents MasterInstrumentComponent[]
  instrumentTrainings  MasterInstrumentTraining[]

  // Billing relations
  subscription TenantSubscription?
  invoices     TenantInvoice[]

  // Device management (Electron offline app)
  devices DeviceRegistration[]

  // What this lab calls each calibration parameter
  calibrationParameters CalibrationParameter[]

  @@index([slug])
  @@index([domain])
}

// ============================================================================
// SUBSCRIPTION & BILLING - B2B2B Model
// ============================================================================

model TenantSubscription {
  id       String @id @default(uuid())
  tenantId String @unique

  // Plan details
  tier   TenantTier         @default(STARTER)
  status SubscriptionStatus @default(ACTIVE)

  // Billing period
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?

  // Pricing (in paise, INR * 100)
  basePriceInPaise Int @default(299900) // ₹2,999

  // Extra seats purchased
  extraStaffSeats        Int @default(0)
  extraCustomerAccounts  Int @default(0)
  extraCustomerUserSeats Int @default(0)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant Tenant        @relation(fields: [tenantId], references: [id])
  usage  TenantUsage[]

  @@index([tenantId])
  @@index([status])
}

// Monthly usage tracking
model TenantUsage {
  id             String @id @default(uuid())
  subscriptionId String

  // Period
  periodStart DateTime
  periodEnd   DateTime

  // Counters
  certificatesIssued   Int @default(0)
  staffUserCount       Int @default(0)
  customerAccountCount Int @default(0)
  customerUserCount    Int @default(0)
  apiCallCount         Int @default(0)
  storageUsedMb        Int @default(0)

  // Snapshot at period end (for billing)
  snapshotAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription TenantSubscription @relation(fields: [subscriptionId], references: [id])

  @@unique([subscriptionId, periodStart])
  @@index([subscriptionId])
  @@index([periodStart])
}

// Billing history (for future Razorpay integration)
model TenantInvoice {
  id       String @id @default(uuid())
  tenantId String

  // Invoice details
  invoiceNumber String   @unique
  periodStart   DateTime
  periodEnd     DateTime

  // Line items (JSON for flexibility)
  lineItems Json // [{description, quantity, unitPrice, amount}]

  // Totals (in paise)
  subtotal Int
  tax      Int // GST 18%
  total    Int

  // Payment
  status           InvoiceStatus @default(DRAFT)
  dueDate          DateTime
  paidAt           DateTime?
  paymentMethod    String?
  paymentReference String? // Razorpay payment ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([invoiceNumber])
}

// ============================================================================
// USER MODELS
// ============================================================================

model User {
  id               String    @id @default(uuid())
  tenantId         String
  email            String
  name             String
  passwordHash     String?
  role             String    @default("ENGINEER")
  isAdmin          Boolean   @default(false)
  adminType        String?
  assignedAdminId  String?
  signatureUrl     String?
  isActive         Boolean   @default(false)
  activationToken  String?   @unique
  activationExpiry DateTime?
  activatedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  googleId         String?   @unique
  authProvider     String    @default("PASSWORD")
  profileImageUrl  String?

  // Tenant relation
  tenant Tenant @relation(fields: [tenantId], references: [id])

  // Other relations
  createdCertificates            Certificate[]                 @relation("CertificateCreator")
  modifiedCertificates           Certificate[]                 @relation("CertificateModifier")
  reviewedCertificates           Certificate[]                 @relation("CertificateReviewer")
  events                         CertificateEvent[]            @relation("EventActor")
  uploadedCertificateImages      CertificateImage[]            @relation("CertificateImageUploader")
  reviewedRevisions              CertificateRevision[]         @relation("RevisionReviewer")
  submittedRevisions             CertificateRevision[]         @relation("RevisionSubmitter")
  chatMessages                   ChatMessage[]
  managedCustomerAccounts        CustomerAccount[]             @relation("AdminToCustomerAccount")
  reviewedRegistrations          CustomerRegistration[]        @relation("RegistrationReviewer")
  reviewedRequests               CustomerRequest[]             @relation("RequestReviewer")
  sentDownloadTokens             DownloadToken[]               @relation("DownloadTokenSender")
  requestedInternalRequests      InternalRequest[]             @relation("InternalRequestedBy")
  reviewedInternalRequests       InternalRequest[]             @relation("InternalRequestReviewer")
  modifiedInstruments            MasterInstrument[]            @relation("InstrumentModifier")
  uploadedInstrumentCertificates MasterInstrumentCertificate[] @relation("InstrumentCertificateUploader")
  engineerInstrumentTrainings    MasterInstrumentTraining[]    @relation("EngineerInstrumentTrainings")
  uploadedTrainingCertificates   MasterInstrumentTraining[]    @relation("TrainingCertificateUploader")
  capabilityAudits               MasterCapabilityAudit[]
  notifications                  Notification[]
  passwordResetTokens            PasswordResetToken[]
  resolvedFeedback               ReviewFeedback[]              @relation("FeedbackResolver")
  authoredFeedback               ReviewFeedback[]              @relation("FeedbackAuthor")
  sectionSignoffs                CertificateSectionSignoff[]   @relation("SectionSignoffActor")
  signatures                     Signature[]
  uploadedUUCImages              UUCImage[]
  assignedAdmin                  User?                         @relation("EngineerToAdmin", fields: [assignedAdminId], references: [id])
  engineers                      User[]                        @relation("EngineerToAdmin")

  // Device management (Electron offline app)
  devices            DeviceRegistration[]
  offlineCodeBatches OfflineCodeBatch[]

  // Desktop VPN provisioning (WireGuard request-approval flow)
  vpnProvisioningToken String?   @unique
  vpnTokenGeneratedAt  DateTime?
  vpnPeer              VpnPeer?

  // Two-Factor Authentication (2FA)
  totpSecret     String? // Encrypted TOTP secret
  totpEnabled    Boolean   @default(false)
  totpVerifiedAt DateTime? // When 2FA was first verified
  backupCodes    String[] // Hashed backup codes

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, role])
}

model CustomerUser {
  id                String    @id @default(uuid())
  tenantId          String
  email             String
  name              String
  passwordHash      String?
  companyName       String?
  customerAccountId String?
  isActive          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  isPoc             Boolean   @default(false)
  activatedAt       DateTime?
  activationToken   String?   @unique
  activationExpiry  DateTime?

  // Tenant relation
  tenant Tenant @relation(fields: [tenantId], references: [id])

  // Other relations
  approvalTokens      ApprovalToken[]
  events              CertificateEvent[]
  chatMessages        ChatMessage[]
  pocForAccount       CustomerAccount?     @relation("PrimaryPOC")
  requestedRequests   CustomerRequest[]    @relation("RequestedBy")
  customerAccount     CustomerAccount?     @relation("CustomerUsers", fields: [customerAccountId], references: [id])
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  signatures          Signature[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([customerAccountId])
  @@index([activationToken])
}

model CustomerAccount {
  id              String   @id @default(uuid())
  tenantId        String
  companyName     String
  address         String?
  contactEmail    String?
  contactPhone    String?
  assignedAdminId String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  primaryPocId    String?  @unique

  // Tenant relation
  tenant Tenant @relation(fields: [tenantId], references: [id])

  // Other relations
  assignedAdmin User?                  @relation("AdminToCustomerAccount", fields: [assignedAdminId], references: [id])
  primaryPoc    CustomerUser?          @relation("PrimaryPOC", fields: [primaryPocId], references: [id])
  certificates  Certificate[]
  registrations CustomerRegistration[]
  requests      CustomerRequest[]
  users         CustomerUser[]         @relation("CustomerUsers")

  @@unique([tenantId, companyName])
  @@index([tenantId])
  @@index([companyName])
  @@index([assignedAdminId])
}

model AllowedGoogleEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  type      String
  role      String   @default("ENGINEER")
  hodId     String?
  name      String?
  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([type])
}

model CustomerRegistration {
  id                String          @id @default(uuid())
  email             String          @unique
  name              String
  passwordHash      String
  customerAccountId String
  status            String          @default("PENDING")
  reviewedById      String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime        @default(now())
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id])
  reviewedBy        User?           @relation("RegistrationReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([customerAccountId])
}

model CustomerRequest {
  id                String                @id @default(uuid())
  type              CustomerRequestType
  status            CustomerRequestStatus @default(PENDING)
  customerAccountId String
  requestedById     String?
  data              String
  reviewedById      String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  customerAccount   CustomerAccount       @relation(fields: [customerAccountId], references: [id])
  requestedBy       CustomerUser?         @relation("RequestedBy", fields: [requestedById], references: [id])
  reviewedBy        User?                 @relation("RequestReviewer", fields: [reviewedById], references: [id])

  @@index([customerAccountId])
  @@index([status])
  @@index([type])
}

// ============================================================================
// MASTER INSTRUMENTS
// ============================================================================

model MasterInstrument {
  id                    String    @id @default(uuid())
  tenantId              String
  instrumentId          String
  version               Int       @default(1)
  isLatest              Boolean   @default(true)
  legacyId              Int?
  category              String
  description           String
  make                  String
  model                 String
  assetNumber           String
  serialNumber          String
  usage                 String?
  calibratedAtLocation  String?
  reportNo              String?
  calibrationDueDate    DateTime?
  rangeData             Json?
  remarks               String?
  status                String?
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  createdById           String?
  changeReason          String?
  importedFromJson      Boolean   @default(false)
  parameterCapabilities String[]  @default([])
  parameterGroup        String?
  parameterRoles        String[]  @default([])
  sopReferences         String[]  @default([])

  // Tenant relation
  tenant Tenant @relation(fields: [tenantId], references: [id])

  // Other relations
  createdBy               User?                         @relation("InstrumentModifier", fields: [createdById], references: [id])
  calibrationCertificates MasterInstrumentCertificate[]
  trainingRecords         MasterInstrumentTraining[]

  @@unique([tenantId, instrumentId, version])
  @@index([tenantId])
  @@index([instrumentId, isLatest])
  @@index([category])
  @@index([description])
  @@index([assetNumber])
  @@index([calibrationDueDate])
  @@index([parameterGroup])
}

model MasterInstrumentCertificate {
  id                 String           @id @default(uuid())
  masterInstrumentId String
  fileName           String
  fileSize           Int
  mimeType           String           @default("application/pdf")
  storagePath        String
  reportNo           String?
  validFrom          DateTime?
  validUntil         DateTime?
  uploadedAt         DateTime         @default(now())
  uploadedById       String
  isActive           Boolean          @default(true)
  isLatest           Boolean          @default(true)
  masterInstrument   MasterInstrument @relation(fields: [masterInstrumentId], references: [id], onDelete: Cascade)
  uploadedBy         User             @relation("InstrumentCertificateUploader", fields: [uploadedById], references: [id])

  // Which capability this certificate covers. Null until assigned, so every row that
  // exists today stays valid.
  capabilityProfileId String?
  capabilityProfile   MasterCapabilityProfile? @relation(fields: [capabilityProfileId], references: [id])

  // A certificate often covers several capabilities: one Fluke 754 certificate
  // carries thermocouple, RTD and DC voltage. The single column above is kept
  // and still written, so nothing that reads it breaks; this is the full list,
  // and an empty one means "whatever the single column says".
  capabilityProfileIds String[] @default([])

  // What the capabilities said when this certificate was read, kept verbatim.
  //
  // Everything else on the page reads a capability live, which is what stops a
  // card and the capability behind it disagreeing. The cost is that an edit
  // after the fact is invisible: the drift review could say a capability had
  // changed but not what it changed from. This is that missing half.
  capabilitySnapshot Json?

  // How many pages the file has, counted from its bytes the first time it is opened and
  // kept. The certificate viewer says "2 of 4"; without this it could only say "page 2".
  pageCount Int?

  // Superseding is one act: the new certificate arrives and the old one is archived
  // in the same step, and the two are linked so the trail from one to the other
  // survives. As two separate steps the second half gets forgotten, which is how an
  // instrument ends up with two certificates both claiming to be current.
  supersededById String?
  supersededBy   MasterInstrumentCertificate?  @relation("CertificateSupersession", fields: [supersededById], references: [id])
  supersedes     MasterInstrumentCertificate[] @relation("CertificateSupersession")

  // Why it was archived, and when. Null on every row that exists today, which reads
  // as "archived before we started asking" rather than as a reason of "".
  archivedReason String?
  archivedAt     DateTime?

  @@index([masterInstrumentId])
  @@index([masterInstrumentId, isLatest])
  @@index([reportNo])
  @@index([capabilityProfileId])
}

model MasterInstrumentTraining {
  id                  String    @id @default(uuid())
  tenantId            String
  instrumentId        String
  masterInstrumentId  String?
  engineerId          String
  // Optional since the evidence can be detached: the wrong file was attached, and
  // the alternative was deleting the record and losing the dates with it. A row
  // with no document is a sign-off nobody can vouch for, which the page says out
  // loud rather than hiding.
  certificateFileName String?
  certificateFileSize Int?
  certificateMimeType String?   @default("application/pdf")
  certificatePath     String?
  trainedAt           DateTime?
  expiresAt           DateTime?
  notes               String?

  // Which components the engineer is signed off on. Empty means the whole
  // instrument, which is both the common case and the honest reading of every
  // row that exists today - someone trained on the pressure modules is not
  // thereby trained on the thermocouple side, but a record that never said so
  // cannot be narrowed after the fact.
  scopeComponentIds String[] @default([])

  uploadedById     String
  uploadedAt       DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isActive         Boolean           @default(true)
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  engineer         User              @relation("EngineerInstrumentTrainings", fields: [engineerId], references: [id])
  uploadedBy       User              @relation("TrainingCertificateUploader", fields: [uploadedById], references: [id])
  masterInstrument MasterInstrument? @relation(fields: [masterInstrumentId], references: [id])

  @@index([tenantId, instrumentId])
  @@index([engineerId])
  @@index([expiresAt])
}

// ============================================================================
// CERTIFICATES
// ============================================================================

model Certificate {
  id                            String    @id @default(uuid())
  tenantId                      String
  certificateNumber             String
  status                        String    @default("DRAFT")
  currentRevision               Int       @default(1)
  reviewerId                    String?
  customerApprovedAt            DateTime?
  calibratedAt                  String?
  srfNumber                     String?
  srfDate                       DateTime?
  dateOfCalibration             DateTime?
  calibrationStartTime          String?
  calibrationEndTime            String?
  calibrationTenure             Int       @default(12)
  /// Whether the tenure was entered in months or in years.
  ///
  /// The tenure itself is stored in months whatever was chosen, so the due date is one
  /// sum and every certificate already written still adds up. This only remembers how
  /// the engineer wrote it - two years reads as two years, not twenty-four months.
  calibrationTenureUnit         String    @default("months")
  dueDateAdjustment             Int       @default(0)
  calibrationDueDate            DateTime?
  dueDateNotApplicable          Boolean   @default(false)
  /// How the due date is written on the certificate.
  ///
  /// A date means different things in different places - 02/09/2026 is September in
  /// Bangalore and February in Boston - and a certificate crossing a border has to be
  /// read the way its reader reads. The stored date does not change; only how it is
  /// printed.
  calibrationDueDateFormat      String    @default("DD/MM/YYYY")
  /// Where the unit under test has no serial number or no instrument id of its own -
  /// a bare sensor, a fixture built in house. The field is not left blank, because a
  /// blank reads as unfinished; it is marked and the certificate prints "Not
  /// Applicable".
  uucSerialNumberNotApplicable  Boolean   @default(false)
  uucInstrumentIdNotApplicable  Boolean   @default(false)
  customerName                  String?
  customerAddress               String?
  uucDescription                String?
  uucMake                       String?
  uucModel                      String?
  uucSerialNumber               String?
  uucInstrumentId               String?
  uucLocationName               String?
  uucMachineName                String?
  ambientTemperature            String?
  relativeHumidity              String?
  calibrationStatus             Json?
  stickerOldRemoved             String?
  stickerNewAffixed             String?
  statusNotes                   String?
  selectedConclusionStatements  Json?
  additionalConclusionStatement String?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
  createdById                   String
  lastModifiedById              String
  signedPdfPath                 String?
  customerContactName           String?
  customerContactEmail          String?
  customerAccountId             String?

  // Tenant relation
  tenant Tenant @relation(fields: [tenantId], references: [id])

  // Customer account link (optional — legacy certs may not have this)
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id])

  // Other relations
  approvalTokens    ApprovalToken[]
  createdBy         User                          @relation("CertificateCreator", fields: [createdById], references: [id])
  lastModifiedBy    User                          @relation("CertificateModifier", fields: [lastModifiedById], references: [id])
  reviewer          User?                         @relation("CertificateReviewer", fields: [reviewerId], references: [id])
  events            CertificateEvent[]
  certificateImages CertificateImage[]
  masterInstruments CertificateMasterInstrument[]
  revisions         CertificateRevision[]
  chatThreads       ChatThread[]
  downloadTokens    DownloadToken[]
  emailDeliveries   EmailDelivery[]
  internalRequests  InternalRequest[]
  notifications     Notification[]
  openSignDocuments OpenSignDocument[]
  parameters        Parameter[]
  feedbacks         ReviewFeedback[]
  signatures        Signature[]
  sectionSignoffs   CertificateSectionSignoff[]
  signingEvidence   SigningEvidence[]
  uucImages         UUCImage[]

  @@unique([tenantId, certificateNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([createdById])
  @@index([reviewerId])
  @@index([customerAccountId])
}

model CertificateEvent {
  id             String           @id @default(uuid())
  certificateId  String
  sequenceNumber Int
  revision       Int
  eventType      String
  eventData      Json
  userId         String?
  customerId     String?
  userRole       String
  createdAt      DateTime         @default(now())
  certificate    Certificate      @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  customer       CustomerUser?    @relation(fields: [customerId], references: [id])
  user           User?            @relation("EventActor", fields: [userId], references: [id])
  feedbacks      ReviewFeedback[]

  @@unique([certificateId, sequenceNumber])
  @@index([certificateId, createdAt])
  @@index([certificateId, revision])
}

model CertificateRevision {
  id             String      @id @default(uuid())
  certificateId  String
  revisionNumber Int
  snapshotData   Json
  status         String
  submittedAt    DateTime?
  submittedById  String?
  reviewedAt     DateTime?
  reviewedById   String?
  reviewOutcome  String?
  reviewNotes    String?
  fromEventSeq   Int
  toEventSeq     Int
  createdAt      DateTime    @default(now())
  certificate    Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  reviewedBy     User?       @relation("RevisionReviewer", fields: [reviewedById], references: [id])
  submittedBy    User?       @relation("RevisionSubmitter", fields: [submittedById], references: [id])

  @@unique([certificateId, revisionNumber])
  @@index([certificateId, createdAt])
}

model EmailDelivery {
  id              String               @id @default(uuid())
  tenantId        String
  certificateId   String
  emailType       String
  recipientEmail  String
  recipientName   String?
  status          EmailDeliveryStatus  @default(QUEUED)
  bullJobId       String?
  idempotencyKey  String               @unique
  providerEmailId String?              @unique
  queuedAt        DateTime             @default(now())
  sentAt          DateTime?
  deliveredAt     DateTime?
  lastEventAt     DateTime?
  failureReason   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  certificate     Certificate          @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  events          EmailDeliveryEvent[]

  @@index([tenantId, certificateId, createdAt])
  @@index([certificateId, emailType, createdAt])
  @@index([status])
}

model EmailDeliveryEvent {
  id              String        @id @default(uuid())
  deliveryId      String
  providerEventId String        @unique
  eventType       String
  occurredAt      DateTime
  details         Json?
  createdAt       DateTime      @default(now())
  delivery        EmailDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, occurredAt])
}

model ReviewFeedback {
  id             String            @id @default(uuid())
  certificateId  String
  revisionNumber Int
  eventId        String?
  feedbackType   String
  targetField    String?
  targetSection  String?
  comment        String
  isResolved     Boolean           @default(false)
  resolvedAt     DateTime?
  resolvedById   String?
  userId         String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  certificate    Certificate       @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  event          CertificateEvent? @relation(fields: [eventId], references: [id])
  resolvedBy     User?             @relation("FeedbackResolver", fields: [resolvedById], references: [id])
  user           User              @relation("FeedbackAuthor", fields: [userId], references: [id])

  @@index([certificateId, revisionNumber])
  @@index([certificateId, isResolved])
}

model Parameter {
  id                          String                        @id @default(uuid())
  certificateId               String
  /// Where the unit under test declares no operating range of its own. The measured
  /// range then stands in for it, and at least one calibration point has to fall
  /// inside that - otherwise the certificate covers a span nothing was read at.
  operatingRangeNotApplicable Boolean                       @default(false)
  parameterName               String
  parameterUnit               String
  /// Which curve or type the unit under test is - Pt-100, Type K. The counterpart of
  /// masterSubtype, which records the same about the master that measured it. Null
  /// where the parameter has no curves, and on anything written before it was asked.
  parameterSubtype            String?
  /// How a master measuring something else serves this parameter.
  ///
  /// Null for the ordinary case, where the master measures the same thing and the
  /// requirement comes from the unit under test. Set where it does not: a temperature
  /// indicator calibrated with a millivolt source records the master parameter it was
  /// mapped to, what that master had to achieve in its own units, and the expression
  /// that converts its readings back. Held as one object because the three are only
  /// meaningful together - a requirement in millivolts means nothing without saying
  /// millivolts of what, and neither means anything without the conversion.
  masterMapping               Json?
  rangeMin                    String?
  rangeMax                    String?
  rangeUnit                   String?
  operatingMin                String?
  operatingMax                String?
  operatingUnit               String?
  leastCountValue             String?
  leastCountUnit              String?
  accuracyValue               String?
  accuracyUnit                String?
  accuracyType                String                        @default("ABSOLUTE")
  errorFormula                String                        @default("A-B")
  showAfterAdjustment         Boolean                       @default(false)
  requiresBinning             Boolean                       @default(false)
  bins                        Json?
  // Section 05 column schema: fieldDefinitions plus errorConfig for this parameter's
  // results table. Null means the parameter predates the dynamic table, in which case
  // the default Master/UUC columns are derived from its results on load.
  fieldSchema                 Json?
  tableName                   String?
  sopReference                String?
  masterInstrumentId          String?
  /// Which capability profile of the master instrument was used, and where that profile
  /// records curves, which curve. Declared by the engineer, not inferred: the readings
  /// cannot tell a source from a measuring device, nor a Pt-100 from a Cu-53. Null on a
  /// parameter saved before the declaration existed.
  masterProfileId             String?
  masterSubtype               String?
  /// Why a master whose accuracy ratio falls below the lab's threshold was accepted.
  /// Null where the ratio meets it.
  masterAcceptanceReason      String?
  sortOrder                   Int                           @default(0)
  results                     CalibrationResult[]
  masterInstruments           CertificateMasterInstrument[]
  certificate                 Certificate                   @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId])
}

model CalibrationResult {
  id               String    @id @default(uuid())
  parameterId      String
  pointNumber      Int
  standardReading  String?
  beforeAdjustment String?
  afterAdjustment  String?
  errorObserved    Float?
  isOutOfLimit     Boolean   @default(false)
  // Values for this row keyed by field id, for columns beyond the fixed three above.
  // Null for rows written before the dynamic table.
  values           Json?
  parameter        Parameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  @@index([parameterId])
}

model CertificateMasterInstrument {
  id                       String      @id @default(uuid())
  certificateId            String
  parameterId              String?
  masterInstrumentId       String
  category                 String?
  description              String?
  make                     String?
  model                    String?
  assetNo                  String?
  serialNumber             String?
  calibratedAt             String?
  reportNo                 String?
  calibrationDueDate       String?
  sopReference             String
  /**
   * What the master's own certificate says, snapshotted when it was chosen.
   * These live on the capability profile in the master registry, which is regenerated
   * as instruments are recalibrated - so reading them live would make a reissued
   * certificate print numbers the original never carried. A certificate records what
   * was true at calibration, so it holds its own copy.
   * Null on certificates written before this existed; the PDF prints "Not recorded".
   */
  capabilityParameter      String?
  masterLeastCount         String?
  masterLeastCountUnit     String?
  masterAccuracy           String?
  masterAccuracyUnit       String?
  /// The master's own bands over the stretch it was used, as its register states them.
  ///
  /// The two scalars above are one pair, taken from whichever band the used range
  /// resolved to. That is the whole truth for a master with one band, and half this
  /// lab's profiles have exactly one. For the rest it describes part of a range and
  /// stands in for all of it: a Fluke 5522A sourcing DC current declares five bands
  /// between 0 and 329.9, with different resolutions and accuracies in each.
  ///
  /// So the overlapping bands are kept as written, in order:
  /// [{ from, to, leastCount, leastCountUnit, accuracy, accuracyUnit }]. Null on every
  /// certificate written before this, which reads the scalars as it always did.
  masterBands              Json?
  /**
   * What the reviewer decided about this master, where the app could not rate it.
   * The engineer is stopped and made to write why a master they could not vouch for
   * was used anyway. Nobody was ever asked to agree with that: approving the
   * certificate accepted it silently. ACCEPTED or REJECTED, and for a rejection the
   * reason - which is the text that pre-fills Request Revision, so the reviewer writes
   * it once, where they saw it.
   * Held against the revision it was made at, for the same reason a section sign-off
   * is: a decision about a master the engineer has since changed is not a decision
   * about the master now on the certificate.
   */
  reviewerDecision         String?
  reviewerDecisionReason   String?
  reviewerDecisionById     String?
  reviewerDecisionAt       DateTime?
  reviewerDecisionRevision Int?
  /// The stretch of the parameter's range this master was used over, and what it was
  /// judged against. Null means the whole of it - two masters can share a parameter,
  /// either both covering it or each taking a part.
  rangeFrom                String?
  rangeTo                  String?
  /// How this master was used, for the parameter it serves. On the pairing rather than
  /// on the parameter, which had room for one master's answers and so for one master.
  masterProfileId          String?
  masterSubtype            String?
  masterAcceptanceReason   String?
  certificate              Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  parameter                Parameter?  @relation(fields: [parameterId], references: [id])

  @@index([certificateId])
  @@index([parameterId])
}

/**
 * One section of a certificate, read and signed off by a reviewer.
 * A reviewer could already say precisely what was wrong - Request Revision files a
 * comment against a named section - but saying something was right had one setting:
 * one Approve covering all seven sections, recording nothing about which of them
 * anyone read. This is the other half, so "did anybody look at the conclusion?" is a
 * question with an answer.
 * Kept against the revision it was made at rather than cleared when one is raised. A
 * tick cannot vouch for a section the reviewer never saw, so a sign-off from revision
 * 1 simply does not count towards revision 2 - and the history still shows that
 * somebody read it once, which is worth keeping.
 */
model CertificateSectionSignoff {
  id            String      @id @default(uuid())
  certificateId String
  /// One of REVISION_SECTIONS: summary, uuc-details, master-inst, environment,
  /// results, remarks, conclusion.
  section       String
  revision      Int
  userId        String?
  userRole      String
  checkedAt     DateTime    @default(now())
  /**
   * A hash of the section's content as it stood when the tick was made.
   *
   * Held against a revision alone, a tick was wrong in both directions: a new revision
   * cleared all seven even though the engineer touched two, and the two they touched
   * are not reliably the ones the revision request named - an engineer sent back to
   * fix Section 3 may correct a reading in Section 5 while they are in there.
   *
   * The tick stands while this still matches and lapses when it does not, whatever
   * moved the content. Null on rows written before this, which fall back to counting
   * for their own revision only.
   */
  contentHash   String?
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  user          User?       @relation("SectionSignoffActor", fields: [userId], references: [id])

  /// A reviewer who unticks and ticks again is replacing an answer, not adding one.
  @@unique([certificateId, section, revision])
  @@index([certificateId])
}

